DATABASE_URL="postgresql://postgres:postgres@localhost:5432/owlex"
PORT=5000
FRONTEND_URL=https://owlfront.vercel.app,http://localhost:3000

# Where contact form notifications are delivered.
ADMIN_EMAIL=anwarramo38@gmail.com

# Email delivery — Resend HTTP API (preferred).
# Railway blocks outbound SMTP, so the SMTP settings below cannot work there.
# Set this and delivery goes over HTTPS instead.
RESEND_API_KEY=re_your_api_key
# Must be a Resend-verified domain. onboarding@resend.dev works without a
# domain but can only deliver to the Resend account owner's address.
MAIL_FROM=Owlex Contact <onboarding@resend.dev>

# Email delivery — SMTP fallback, used only when RESEND_API_KEY is unset.
# Works locally; will time out on Railway.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password

# Shared secret for the admin-only contact routes (GET/PATCH/DELETE
# /api/contact), sent as the x-admin-secret header. If this is unset those
# routes are denied outright — they are never left open.
ADMIN_SECRET=generate-a-long-random-string
